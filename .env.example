# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (seed script). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → Database → Connection string (URI, session pooler)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Shows the one-tap demo logins on the login screen
NEXT_PUBLIC_DEMO_MODE=true
